PORT=5000
DATABASE_URL=postgresql://postgres:password@localhost:5432/mai_network
DATABASE_SSL=false
CLIENT_ORIGIN=http://localhost:3000
WEBAPP_URL=http://localhost:3000
BOT_TOKEN=123456:replace_me
BOT_USERNAME=maitoken_bot
ALLOW_DEV_AUTH=true
ADMIN_KEY=replace-with-a-long-random-secret

# Mining / levels (server authoritative)
INITIAL_BALANCE=0
FREE_MINING_PER_DAY=5
LEVEL1_MINING_PER_DAY=10
LEVEL_SPEED_STEP=2
LEVEL_HOLDING_STEP=1000
MAX_LEVEL=1000
FARM_CYCLE_SECONDS=86400
DAILY_BONUS=1

# Daily tasks
AD_REWARD=1
AD_DAILY_LIMIT=200
AD_COOLDOWN_SECONDS=5
AD_PROVIDER_MODE=external
AD_PROVIDER_URL=https://ads-provider.example/watch
AD_WEBHOOK_SECRET=replace_me
TASK_REWARD=2
NEWS_CHAT_ID=@MAI_News_Official
NEWS_LINK=https://t.me/MAI_News_Official
PAYOUT_CHAT_ID=@MAI_Payout_Proof
PAYOUT_LINK=https://t.me/MAI_Payout_Proof
COMMUNITY_CHAT_ID=@MAICommunityChat
COMMUNITY_LINK=https://t.me/MAICommunityChat

# Referrals
REFERRER_REWARD=10
REFERRED_REWARD=5
REFERRAL_MILESTONES=5:25,10:60,25:175,50:400,100:1000

# Promotions
PROMOTE_MAI_PER_SLOT=0.1
PROMOTE_GRAM_PER_SLOT=0.001

# Withdrawals
MIN_WITHDRAWAL=500
WITHDRAW_FEE_FIXED=0
WITHDRAW_FEE_PERCENT=0
WITHDRAW_MAX_PER_REQUEST=1000000
WITHDRAW_MAX_REQUESTS_PER_DAY=3
WITHDRAW_REQUEST_COOLDOWN_SECONDS=30
WALLET_CHANGE_LOCK_SECONDS=86400
MANUAL_REVIEW_THRESHOLD=10000

# Security: off | observe | soft | hard
DEVICE_POLICY=observe
MAX_ACCOUNTS_PER_DEVICE=2
MAX_ACCOUNTS_PER_IP_DAY=8
BLOCK_WITHDRAW_ON_RISK=true
